@page
@model InmobiliariaRodriguez.Web.Pages.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container mt-5 mb-5 flex-grow-1 d-flex align-items-center">
    <div class="row w-100 justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 overflow-hidden">
                <div class="card-header bg-warning text-dark text-center py-4 border-bottom-dorado">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-shield-lock me-2"></i> Cambio de clave requerido</h5>
                </div>
                <div class="card-body p-4 bg-white">
                    <p class="text-muted text-center mb-4">
                        Por seguridad, debes actualizar tu contraseña por defecto antes de ingresar al sistema.
                    </p>

                    @if (!string.IsNullOrEmpty(Model.MensajeError))
                    {
                        <div class="alert alert-danger text-center shadow-sm">
                            @Model.MensajeError
                        </div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold texto-primario">Nueva Contraseña</label>
                            <input type="password" asp-for="NuevaPassword" class="form-control" required autofocus />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold texto-primario">Confirmar Contraseña</label>
                            <input type="password" asp-for="ConfirmarPassword" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-primario w-100 py-2 fw-bold">
                            Guardar e Ingresar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>