@page "{id:int}"
@model InmobiliariaRodriguez.Web.Pages.Admin.Usuarios.EliminarModel
@{
    ViewData["Title"] = "Eliminar Empleado";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white fs-5 fw-bold py-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Dar de baja empleado
                </div>

                <div class="card-body p-4">
                    <h4 class="card-title text-danger mb-3">¿Confirmás la baja de este usuario?</h4>
                    <p class="text-muted">
                        Esta persona ya no podrá acceder al panel de administración. Sus acciones pasadas quedarán registradas, pero su acceso será revocado inmediatamente.
                    </p>

                    <div class="bg-light p-3 rounded mb-4 mt-3 border">
                        <h5 class="fw-bold texto-primario mb-1">@Model.Usuario.Nombre @Model.Usuario.Apellido</h5>
                        <p class="mb-0 text-muted"><strong>DNI / Usuario:</strong> @Model.Usuario.Dni</p>
                    </div>

                    <form method="post" class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4">Sí, eliminar acceso</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>