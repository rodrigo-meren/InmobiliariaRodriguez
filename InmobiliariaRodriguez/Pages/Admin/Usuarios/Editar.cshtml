@page "{id:int}"
@model InmobiliariaRodriguez.Web.Pages.Admin.Usuarios.EditarModel
@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <h2 class="texto-primario fw-bold mb-0">Editar Empleado</h2>
                <a asp-page="./Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>

            <form method="post" class="card shadow-sm border-0 bg-white p-4">
                <input type="hidden" asp-for="UsuarioActualizar.Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre</label>
                        <input asp-for="UsuarioActualizar.Nombre" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Apellido</label>
                        <input asp-for="UsuarioActualizar.Apellido" class="form-control" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-bold">DNI</label>
                        <input asp-for="UsuarioActualizar.Dni" type="number" class="form-control" required />
                        <div class="form-text">Si modificás el DNI, recordale al empleado que su nuevo usuario para ingresar será este número.</div>
                    </div>
                </div>

                <div class="mt-4 p-3 bg-light border rounded">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="ResetearClave" id="checkReset">
                        <label class="form-check-label fw-bold text-danger" for="checkReset">
                            Resetear contraseña
                        </label>
                        <p class="text-muted small mb-0 mt-1">Si marcás esta opción, la contraseña actual del empleado se borrará y volverá a ser su DNI. El sistema le pedirá que cree una nueva al ingresar.</p>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <a asp-page="./Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                    <button type="submit" class="btn btn-primario px-4 fw-bold">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>