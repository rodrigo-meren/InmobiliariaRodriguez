@page
@model InmobiliariaRodriguez.Web.Pages.Admin.Usuarios.CrearModel
@{
    ViewData["Title"] = "Nuevo Empleado";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <h2 class="texto-primario fw-bold mb-0">Nuevo Empleado</h2>
                <a asp-page="./Index" class="btn btn-outline-secondary">Volver</a>
            </div>

            <div class="alert alert-info shadow-sm mb-4">
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong>Importante:</strong> El nombre de usuario y la contraseña inicial serán el <strong>DNI</strong> del empleado. El sistema le pedirá que cree una nueva contraseña en su primer ingreso.
            </div>

            <form method="post" class="card shadow-sm border-0 bg-white p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre</label>
                        <input asp-for="NuevoUsuario.Nombre" class="form-control" required autofocus />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Apellido</label>
                        <input asp-for="NuevoUsuario.Apellido" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">DNI (Sin puntos)</label>
                        <input asp-for="NuevoUsuario.Dni" type="number" class="form-control" required />
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primario px-4 fw-bold">Crear Empleado</button>
                </div>
            </form>
        </div>
    </div>
</div>