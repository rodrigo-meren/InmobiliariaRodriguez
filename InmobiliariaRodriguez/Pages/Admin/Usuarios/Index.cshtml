@page
@model InmobiliariaRodriguez.Web.Pages.Admin.Usuarios.IndexModel
@{
    ViewData["Title"] = "Gestión de Empleados";
}

<div class="container mt-4 mb-5">
    <div class="row border-bottom pb-3 mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <h2 class="texto-primario fw-bold">Empleados del Sistema</h2>
                <p class="text-muted mb-0">Administrá quiénes tienen acceso al panel.</p>
            </div>
            <a asp-page="./Crear" class="btn btn-primario fw-bold">
                <i class="bi bi-person-plus-fill me-2"></i> Nuevo Empleado
            </a>
        </div>
    </div>

    <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Nombre Completo</th>
                    <th>DNI</th>
                    <th>Usuario de Acceso</th>
                    <th>Estado de Clave</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var user in Model.Usuarios)
                {
                    <tr>
                        <td class="fw-bold texto-primario">@user.Nombre @user.Apellido</td>
                        <td>@user.Dni</td>
                        <td><span class="badge bg-secondary">@user.NombreUsuario</span></td>
                        <td>
                            @if (user.RequiereCambioPassword)
                            {
                                <span class="badge bg-warning text-dark">Pendiente de cambio</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Actualizada</span>
                            }
                        </td>
                        <td>
                            <a asp-page="./Editar" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                            @if (user.Id != 1)
                            {
                                <a asp-page="./Eliminar" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>