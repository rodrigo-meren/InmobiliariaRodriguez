@page
@model InmobiliariaRodriguez.Web.Pages.Admin.Propiedades.IndexModel
@{
    ViewData["Title"] = "Panel de Propiedades";
}

<div class="container mt-4 mb-5">
    <!-- Cabecera del Panel -->
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <h2 class="texto-primario fw-bold">Propiedades</h2>
            <p class="text-muted mb-0">Gestión del catálogo inmobiliario</p>
        </div>
        <a asp-page="./Crear" class="btn btn-primario">
            + Cargar Propiedad
        </a>
    </div>

    <!-- Tabla de Propiedades -->
    <div class="table-responsive shadow-sm rounded bg-white p-3">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Título</th>
                    <th>Ubicación</th>
                    <th>Operación</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Propiedades)
                {
                    <tr>
                        <td class="fw-bold texto-primario">@item.Titulo</td>
                        <td>@item.Ciudad, @item.Partido</td>
                        <td>@item.TipoOperacion</td>
                        <td>@item.Moneda @item.Precio.ToString("N2")</td>
                        <td>
                            <!-- Pintamos el estado de verde si está disponible -->
                            @if (item.Estado == InmobiliariaRodriguez.Web.Models.EstadoPropiedad.Disponible)
                            {
                                <span class="badge bg-success">@item.Estado</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Estado</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="#" class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                            <a asp-page="./Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash3"></i> Borrar
                            </a>
                        </td>
                    </tr>
                }
                
                <!-- Mensaje si la tabla está vacía -->
                @if (!Model.Propiedades.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No hay propiedades cargadas aún. Hacé clic en "+ Cargar Propiedad" para empezar.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>