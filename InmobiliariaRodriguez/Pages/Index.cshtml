@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="split-container">

    <a asp-page="/Catalogo/Index" asp-route-partido="Avellaneda" class="split-panel" style="background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/a/a2/Avellaneda_centro.jpg/960px-Avellaneda_centro.jpg.webp');">
        <div class="split-content">
            <h2 class="split-title">Avellaneda</h2>
            <span class="split-btn-text text-white">Ver propiedades <i class="bi bi-arrow-right"></i></span>
        </div>
    </a>

    <a asp-page="/Catalogo/Index" asp-route-partido="Quilmes" class="split-panel" style="background-image: url('https://www.infoquilmes.com.ar/fotos/2025/10/95240k76lqns1mp83otr.webp');">
        <div class="split-content">
            <h2 class="split-title">Quilmes</h2>
            <span class="split-btn-text text-white">Ver propiedades <i class="bi bi-arrow-right"></i></span>
        </div>
    </a>

    <a asp-page="/Catalogo/Index" asp-route-partido="LaCosta" class="split-panel" style="background-image: url('https://lacosta.tur.ar/wp-content/uploads/2021/10/DJI_0154-retocada-1024x575.jpg');">
        <div class="split-content">
            <h2 class="split-title">La Costa</h2>
            <span class="split-btn-text text-white">Ver propiedades <i class="bi bi-arrow-right"></i></span>
        </div>
    </a>

</div>